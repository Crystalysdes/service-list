# Токен бота от @BotFather (боту нужен коллекционный юзернейм с Fragment для премиум-эмодзи в канале)
BOT_TOKEN=123456:ABC...
# Telegram ID владельцев через запятую (полный доступ к /admin)
OWNER_IDS=111111111
# Пароль базы данных для docker compose (DATABASE_URL внутри compose собирается из него сам)
POSTGRES_PASSWORD=change-me
# База данных PostgreSQL — нужна только при запуске без docker compose
DATABASE_URL=postgresql+asyncpg://servicelist:change-me@localhost:5432/servicelist
# Crypto Pay (@CryptoBot -> Crypto Pay -> Create App). Для тестов: токен от @CryptoTestnetBot и CRYPTOPAY_TESTNET=true
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false
# Auto-garant: отдельное приложение Crypto Pay только для денег сделок (в его Security включите Transfers)
ESCROW_CRYPTOPAY_TOKEN=
ESCROW_CRYPTOPAY_TESTNET=false
# Часовой пояс для дат в сообщениях и времени бэкапа
TIMEZONE=Europe/Moscow
# Каталог для медиа и бэкапов
DATA_DIR=/data
# Пароль шифрования бэкапов (обязательно сохраните его отдельно!)
BACKUP_PASSPHRASE=
LOG_LEVEL=INFO
